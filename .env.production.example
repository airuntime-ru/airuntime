# Production environment template — copy to .env on the server and fill secrets.
APP_DOMAIN=airuntime.ru
# DEBUG/INFO/WARNING/ERROR - applies to both the API and worker processes.
LOG_LEVEL=INFO

# Cloudflare DNS — auto-sync on website deploy (same as scripts/setup_cloudflare_dns.sh)
SERVER_IP=
CF_ZONE_ID=
CF_API_TOKEN=

POSTGRES_DB=airuntime
POSTGRES_USER=airuntime
POSTGRES_PASSWORD=change-me-postgres

JWT_SECRET_KEY=change-me-jwt
APP_ENCRYPTION_KEY=change-me-encryption-32chars-min
DJANGO_SECRET_KEY=change-me-django
DJANGO_SUPERUSER_PASSWORD=admin123

S3_ACCESS_KEY=airuntime
S3_SECRET_KEY=change-me-minio
S3_BUCKET=airuntime-files

MAIL_ADMIN_PASSWORD=change-me-mail-admin
MAIL_NOREPLY_PASSWORD=change-me-mail-noreply

PROVIDER_NAME=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://routerai.ru/api/v1
DEFAULT_MODEL_OPENAI=gpt-5.6-sol
DEFAULT_MODEL_OPENROUTER=openai/gpt-5.6-sol
BILLING_CREDITS_PER_RUB=100
BILLING_USD_TO_RUB=100
CODEX_REASONING_EFFORT=max
CODEX_SIMPLE_TIMEOUT_SECONDS=300
ORCHESTRATION_TASK_DEFAULT_TIMEOUT_SECONDS=1800

# The orchestration engine (planner -> task graph -> specialist roles/skills/MCP -> evidence ->
# validation -> git checkpoint -> deploy) is the only agent path and every capability in it is
# always on - there are no feature flags for any of it. Run
# `docker compose -f docker-compose.prod.yml build preview` once so the preview stage has its
# image; until then preview degrades gracefully, never crashes.
