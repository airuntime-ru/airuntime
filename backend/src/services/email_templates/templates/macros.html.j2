{# Shared email macros — table-based, inline styles only. #}
{% macro button(label, href) -%}
<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 8px;">
  <tr>
    <td align="left">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ href }}" style="height:44px;v-text-anchor:middle;width:220px;" arcsize="14%" stroke="f" fillcolor="{{ colors.accent }}">
        <w:anchorlock/>
        <center style="color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:bold;">{{ label }}</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-- -->
      <a href="{{ href }}" style="display:inline-block;background-color:{{ colors.accent }};color:#ffffff;font-family:Arial,Helvetica,sans-serif;font-size:16px;font-weight:700;line-height:44px;text-align:center;text-decoration:none;padding:0 22px;border-radius:8px;mso-hide:all;">{{ label }}</a>
      <!--<![endif]-->
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro otp_code(code) -%}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:20px 0;">
  <tr>
    <td align="center" style="background-color:{{ colors.accent_soft }};border:1px solid {{ colors.border }};border-radius:10px;padding:22px 16px;height:96px;">
      <span style="font-family:'Courier New',Courier,monospace;font-size:40px;line-height:1.1;font-weight:700;letter-spacing:8px;color:{{ colors.ink }};">{{ code }}</span>
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro info_box(title=None) -%}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:18px 0;">
  <tr>
    <td style="background-color:{{ colors.page }};border:1px solid {{ colors.border }};border-radius:10px;padding:16px 18px;">
      {% if title %}<p style="margin:0 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:13px;font-weight:700;color:{{ colors.ink }};">{{ title }}</p>{% endif %}
      {{ caller() }}
    </td>
  </tr>
</table>
{%- endmacro %}

{% macro status_badge(label, tone='accent') -%}
{%- set bg = colors.accent_soft -%}
{%- set fg = colors.accent -%}
{%- if tone == 'success' -%}{%- set bg = colors.success_soft -%}{%- set fg = colors.success -%}{%- endif -%}
{%- if tone == 'warning' -%}{%- set bg = colors.warning_soft -%}{%- set fg = colors.warning -%}{%- endif -%}
{%- if tone == 'error' -%}{%- set bg = colors.error_soft -%}{%- set fg = colors.error -%}{%- endif -%}
<span style="display:inline-block;background-color:{{ bg }};color:{{ fg }};font-family:Arial,Helvetica,sans-serif;font-size:12px;font-weight:700;line-height:1;padding:7px 10px;border-radius:6px;">{{ label }}</span>
{%- endmacro %}

{% macro divider() -%}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:20px 0;">
  <tr>
    <td style="border-top:1px solid {{ colors.border }};font-size:0;line-height:0;">&nbsp;</td>
  </tr>
</table>
{%- endmacro %}

{% macro security_notice(text) -%}
<p style="margin:18px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.55;color:{{ colors.muted }};">{{ text }}</p>
{%- endmacro %}

{% macro billing_summary(rows) -%}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:16px 0;border:1px solid {{ colors.border }};border-radius:10px;overflow:hidden;">
  {% for row in rows %}
  <tr>
    <td style="padding:12px 16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:{{ colors.muted }};{% if not loop.last %}border-bottom:1px solid {{ colors.border }};{% endif %}">{{ row.label }}</td>
    <td align="right" style="padding:12px 16px;font-family:Arial,Helvetica,sans-serif;font-size:14px;font-weight:700;color:{{ colors.ink }};{% if not loop.last %}border-bottom:1px solid {{ colors.border }};{% endif %}">{{ row.value }}</td>
  </tr>
  {% endfor %}
</table>
{%- endmacro %}

{% macro project_link(url, label=None) -%}
<p style="margin:12px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.5;color:{{ colors.muted }};word-break:break-all;">
  <a href="{{ url }}" style="color:{{ colors.accent }};text-decoration:none;">{{ label or url }}</a>
</p>
{%- endmacro %}
