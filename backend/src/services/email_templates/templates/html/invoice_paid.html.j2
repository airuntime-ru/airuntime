{% extends "base.html.j2" %}
{% from "macros.html.j2" import button, billing_summary, status_badge %}
{% block body %}
<p style="margin:0 0 12px;">{{ status_badge("Оплачен", "success") }}</p>
<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.55;color:{{ colors.muted }};">Платёж подтверждён. Кредиты зачислены на ваш баланс.</p>
{{ billing_summary(summary_rows) }}
{% if billing_url %}{{ button("Открыть кабинет", billing_url) }}{% endif %}
{% endblock %}
