{% extends "base.html.j2" %}
{% from "macros.html.j2" import button, security_notice %}
{% block body %}
<p style="margin:0;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.55;color:{{ colors.muted }};">Нажмите кнопку ниже, чтобы задать новый пароль. Ссылка одноразовая.</p>
{{ button("Сбросить пароль", reset_url) }}
<p style="margin:8px 0 0;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:1.5;color:{{ colors.muted }};word-break:break-all;">Или откройте ссылку:<br /><span style="color:{{ colors.ink }};">{{ reset_url }}</span></p>
{{ security_notice("Ссылка действует " ~ link_ttl ~ ". Если вы не запрашивали сброс, просто проигнорируйте это письмо.") }}
{% endblock %}
